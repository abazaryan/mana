{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abazaryan.github.io/mana/mana-deck.schema.json",
  "title": "Колода «Маны» (deck.json), формат mana-deck, версия 1",
  "description": "Описание: docs/DECK_FORMAT.md. Название колоды — имя ZIP-файла без расширения, в deck.json его нет. Схема проверяет строение файла; проверки между записями (одинаковые id, теги без описания, наличие аудиофайлов, поддержка языка, род по языку, размер архива) делает валидатор src/core/deckFormat.ts.",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "revision",
    "language",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "mana-deck"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "description": "Номер редакции колоды; растёт при каждом изменении.",
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "description": "Изучаемый язык, код BCP-47: fr-FR, en-GB, de-DE, lb-LU.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
    },
    "tags": {
      "description": "Словарь тегов: код → название на языках интерфейса.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/localized"
      }
    },
    "title": {
      "description": "Название колоды на языках интерфейса (Р30); без него — имя ZIP-файла при установке.",
      "$ref": "#/$defs/localized"
    },
    "entries": {
      "description": "Порядок записей — порядок знакомства с новыми записями.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Устойчивый идентификатор: не меняется при исправлении колоды.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "localized": {
      "description": "Текст на языках интерфейса (ISO 639-1: tg, ru, en), хотя бы на одном. Другие ключи валидатор принимает с предупреждением, приложение их не показывает.",
      "type": "object",
      "properties": {
        "tg": { "$ref": "#/$defs/text" },
        "ru": { "$ref": "#/$defs/text" },
        "en": { "$ref": "#/$defs/text" }
      },
      "anyOf": [
        { "required": ["tg"] },
        { "required": ["ru"] },
        { "required": ["en"] }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "text",
        "meaning",
        "skills"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text",
          "description": "Текст на изучаемом языке — единственный правильный ответ."
        },
        "ipa": {
          "$ref": "#/$defs/text",
          "description": "Произношение в IPA, без скобок [ ] и / /."
        },
        "meaning": {
          "$ref": "#/$defs/localized"
        },
        "hint": {
          "$ref": "#/$defs/localized",
          "description": "Подсказка, видна до ответа."
        },
        "note": {
          "$ref": "#/$defs/localized",
          "description": "Заметка, видна после ответа."
        },
        "audio": {
          "type": "string",
          "pattern": "^audio/[^\\\\]+\\.(mp3|wav)$"
        },
        "speech": {
          "$ref": "#/$defs/text",
          "description": "Текст для голоса браузера, если он читает text неверно (ciao → tchao); только без audio. Ответ и показ — по text."
        },
        "gender": {
          "enum": [
            "m",
            "f",
            "n"
          ],
          "description": "Род самого слова; показывается только при знакомстве."
        },
        "form": {
          "description": "Какая форма нужна в ответе; подсказки до ответа.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "determiner": {
              "enum": [
                "definite",
                "indefinite"
              ]
            },
            "gender": {
              "enum": [
                "m",
                "f",
                "n"
              ]
            },
            "number": {
              "enum": [
                "singular",
                "plural"
              ]
            }
          }
        },
        "tags": {
          "description": "Коды тегов из словаря tags колоды.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "listen",
              "speak",
              "write"
            ]
          }
        }
      }
    }
  }
}
