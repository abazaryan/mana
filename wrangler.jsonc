// Cloudflare Workers: the static site (dist/) and the API (/api/*, worker/) on one address —
// decisions R32, R33 item 2, R36. Workers Builds on every push to main: build command
// `npm test && npm run build`, deploy command `npx wrangler deploy`. Headers of the static
// files live in public/_headers; headers of API responses — in worker/http.ts.
// Step-by-step setup in the Cloudflare dashboard, migrations, checks: docs/DEPLOY.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mana",
  "main": "worker/index.ts",
  // Navigation requests never invoke a Worker script from 2025-04-01 on.
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    // Lets the Worker hand paths with no file back to the static files (worker/index.ts).
    "binding": "ASSETS",
    // The app routes by #/…: only / is needed. An unknown path gets a plain 404, not
    // index.html — with base './' a nested path would load its scripts from a wrong folder.
    "not_found_handling": "none",
    // Only the API runs the Worker before the files.
    "run_worker_first": ["/api/*"],
  },
  // Only with an explicit id of a database created with jurisdiction eu: without one, wrangler
  // creates a database of its own on deploy, without the jurisdiction (worker/wrangler-config.test.ts).
  // Migrations are applied by hand before the push that needs them (docs/DEPLOY.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mana",
      "database_id": "402d25f9-3390-45f4-9177-57621f470661",
      "migrations_dir": "migrations",
    },
  ],
  // Hourly cleanup of sign-in rows (worker/cleanup.ts): counter rows with an IP hash must be
  // gone within a day — promised in the data notice (docs/NOTICE.md); one of 5 Free cron slots.
  "triggers": { "crons": ["17 * * * *"] },
  // No Cloudflare logs or analytics: answers and recordings stay on the device.
  "observability": { "enabled": false },
  // No Wrangler usage telemetry from the build machine.
  "send_metrics": false,
  // The site's address: https://mana.amisipehr.workers.dev. Per-version preview URLs
  // would be public copies with their own empty database: off.
  "workers_dev": true,
  "preview_urls": false,
}
